# ===========================================
# X0X ChatApp 生产环境配置
# ===========================================
# 
# 环境变量传递逻辑:
# 1. 此文件(.env.prod)被Docker Compose自动读取
# 2. Docker Compose通过environment配置传递给容器
# 3. 容器内程序直接使用环境变量(不读取此文件)
# 4. docker-entrypoint.sh处理环境变量并生成app-config.json
# 
# 重要: 此文件不会被打包到容器内，仅供Docker Compose使用
# ===========================================

# 镜像和仓库配置 (注意：镜像名必须小写)
REGISTRY_URL=nrt.vultrcr.com/ex00/
IMAGE_TAG=latest

# 应用基本信息
APP_NAME="X0X Chat App"
APP_VERSION=1.0.0

# 服务器配置
NODE_ENV=production
HOST=0.0.0.0

# 端口配置 (HTTP + HTTPS)
HTTP_PORT=80
HTTPS_PORT=443

# 用户配置
USER_ID=1000
GROUP_ID=1000

# 字体服务配置
# 此值会被Docker Compose传递给容器，由docker-entrypoint.sh生成app-config.json
FONT_SERVICE_URL=http://localhost:7000

# SSL配置
ENABLE_HTTPS=true
SSL_CERT_PATH=../ssl-certs  
DISABLE_CORS_HEADERS=false

# 日志配置
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# 资源限制配置
CPU_LIMIT=1.0
CPU_RESERVATION=0.5
MEMORY_LIMIT=512M
MEMORY_RESERVATION=256M

# ===========================================
# 部署说明
# ===========================================
# 1. 使用此配置启动生产环境:
#    docker-compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# 2. 查看日志:
#    docker-compose --env-file .env.prod -f docker-compose.prod.yml logs -f
#
# 3. 停止服务:
#    docker-compose --env-file .env.prod -f docker-compose.prod.yml down
#
# 4. 更新镜像:
#    docker-compose --env-file .env.prod -f docker-compose.prod.yml pull
#    docker-compose --env-file .env.prod -f docker-compose.prod.yml up -d
# ===========================================