# Docker Compose 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 外部访问主机配置
# 本地开发
EXTERNAL_HOST=localhost

# 服务器部署 (使用服务器IP)
# EXTERNAL_HOST=192.168.1.100

# 域名部署
# EXTERNAL_HOST=your-domain.com

# 内网IP部署  
# EXTERNAL_HOST=10.0.0.50

# 示例：不同部署场景
# 开发环境: EXTERNAL_HOST=localhost
# 测试环境: EXTERNAL_HOST=test.company.com  
# 生产环境: EXTERNAL_HOST=app.company.com