  }

  /// 删除消息
  @override
  Future<bool> deleteMessage(String messageId) async {
    try {
      _logger.i('🗑️ 开始删除消息', extra: {'messageId': messageId});
      
      final message = await getMessageById(messageId);
      if (message == null) {
        _logger.w('🗑️ 删除失败：找不到消息', extra: {'messageId': messageId});
        return false;
      }

      // 检查是否是当前用户的消息
      if (message.senderId != _currentUser.userId) {
        _logger.w('🗑️ 删除失败：只能删除自己的消息', extra: {'messageId': messageId});
        return false;
      }

      // 检查消息是否已经被删除
      if (message.status == MessageStatus.deleted) {
        _logger.w('🗑️ 删除失败：消息已被删除', extra: {'messageId': messageId});
        return false;
      }

      // 更新本地数据库状态
      await _isar.writeTxn(() async {
        message.status = MessageStatus.deleted;
        message.updatedAt = DateTime.now();
        await _messages.put(message);
      });

      // 通知UI更新
      await _notifyMessageUpdated(message);

      // TODO: 实现服务器端删除API
      // 暂时只更新本地状态，等后端API实现后再连接
      _logger.i('🗑️ 消息删除完成（仅本地）', extra: {'messageId': messageId});

      return true;
    } catch (error) {
      _logger.e('🗑️ 删除消息失败', error: error, extra: {'messageId': messageId});
      return false;
    }
  }
}
