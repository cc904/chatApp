/**
 * MiniTex - 免字体文本渲染器
 * 基于Canvas 2D实现文本排版与绘制，不依赖TTF字体文件
 * Version: 1.0.0
 */
(function(global) {
  'use strict';

  // MiniTex 核心配置
  const MiniTex = {
    version: '1.0.0',
    initialized: false,
    
    // 系统字体回退列表
    fontFallbacks: [
      'system-ui',
      '-apple-system',
      'BlinkMacSystemFont',
      'Segoe UI',
      'PingFang SC',
      'Hiragino Sans GB',
      'Microsoft YaHei',
      'Helvetica Neue',
      'Helvetica',
      'Arial',
      'sans-serif'
    ],
    
    // 初始化MiniTex
    init: function() {
      if (this.initialized) return;
      
      console.log('🎨 MiniTex v' + this.version + ' 初始化');
      console.log('📝 免字体文本渲染器已启用');
      console.log('🔤 支持字体回退:', this.fontFallbacks.slice(0, 3).join(', '));
      
      // 注册字体回退机制
      this.registerFontFallback();
      
      // 启用Canvas文本优化
      this.enableCanvasTextOptimization();
      
      this.initialized = true;
      
      // 触发初始化完成事件
      if (typeof window !== 'undefined') {
        window.dispatchEvent(new CustomEvent('minitex-ready', {
          detail: { version: this.version }
        }));
      }
    },
    
    // 注册字体回退机制
    registerFontFallback: function() {
      const style = document.createElement('style');
      style.textContent = `
        /* MiniTex 字体回退配置 */
        .flt-text-editing::placeholder,
        .flt-text-editing,
        flt-paragraph,
        .flt-paragraph {
          font-family: ${this.fontFallbacks.join(', ')} !important;
        }
        
        /* 确保所有文本元素使用系统字体 */
        * {
          font-family: ${this.fontFallbacks.join(', ')};
        }
        
        /* Canvas文本渲染优化 */
        canvas {
          text-rendering: optimizeSpeed;
          font-smooth: never;
          -webkit-font-smoothing: none;
        }
      `;
      document.head.appendChild(style);
    },
    
    // 启用Canvas文本优化
    enableCanvasTextOptimization: function() {
      // 重写Canvas文本绘制方法以使用系统字体
      if (typeof CanvasRenderingContext2D !== 'undefined') {
        const originalFillText = CanvasRenderingContext2D.prototype.fillText;
        const originalStrokeText = CanvasRenderingContext2D.prototype.strokeText;
        
        CanvasRenderingContext2D.prototype.fillText = function(text, x, y, maxWidth) {
          this.font = this.font.replace(/['"][\w\s-]+['"]/, `"${MiniTex.fontFallbacks[0]}"`);
          return originalFillText.call(this, text, x, y, maxWidth);
        };
        
        CanvasRenderingContext2D.prototype.strokeText = function(text, x, y, maxWidth) {
          this.font = this.font.replace(/['"][\w\s-]+['"]/, `"${MiniTex.fontFallbacks[0]}"`);
          return originalStrokeText.call(this, text, x, y, maxWidth);
        };
      }
    },
    
    // 检测字体支持情况
    checkFontSupport: function() {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      const testText = '测试Abc123';
      
      const results = {};
      this.fontFallbacks.forEach(font => {
        ctx.font = `16px "${font}"`;
        const metrics = ctx.measureText(testText);
        results[font] = {
          width: metrics.width,
          available: metrics.width > 0
        };
      });
      
      return results;
    }
  };
  
  // 导出到全局作用域
  global.MiniTex = MiniTex;
  
  // DOM加载完成后自动初始化
  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        MiniTex.init();
      });
    } else {
      // DOM已经加载完成
      setTimeout(function() {
        MiniTex.init();
      }, 100);
    }
  }
  
  // 兼容AMD/CommonJS
  if (typeof module !== 'undefined' && module.exports) {
    module.exports = MiniTex;
  } else if (typeof define === 'function' && define.amd) {
    define(function() {
      return MiniTex;
    });
  }
  
})(typeof window !== 'undefined' ? window : this);

// Flutter Web CanvasKit集成支持
if (typeof window !== 'undefined') {
  window.addEventListener('flutter-initialized', function() {
    console.log('🔗 Flutter Web + MiniTex 集成完成');
    
    // 强制Flutter使用系统字体
    if (window.flutterCanvasKit) {
      console.log('🎯 CanvasKit检测到，启用MiniTex字体回退');
    }
  });
}