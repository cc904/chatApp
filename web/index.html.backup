<!DOCTYPE html>
<html>
<head>
  <base href="$FLUTTER_BASE_HREF">
  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="description" content="A Flutter chat application.">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="apple-mobile-web-app-title" content="cc">
  <link rel="apple-touch-icon" href="icons/Icon-192.png">
  <link rel="icon" type="image/png" href="favicon.png"/>
  <title>cc</title>
  <link rel="manifest" href="manifest.json">
  
  <!-- 简化字体CSS -->
  <link rel="stylesheet" href="fonts.css" type="text/css">
</head>

<body>
  <script>
    console.log('🔍 Flutter Web 清理版本 - 无拦截器');
    
    // 强制使用本地CanvasKit，避免从Google CDN加载
    window.flutterConfiguration = {
      canvasKitBaseUrl: "/canvaskit/",
      useLocalCanvasKit: true
    };
  </script>
  
  <script src="flutter_bootstrap.js" async></script>
  
  <script>
    // 确保在flutter_bootstrap.js加载后修改配置
    window.addEventListener('DOMContentLoaded', function() {
      if (window._flutter && window._flutter.buildConfig) {
        window._flutter.buildConfig.useLocalCanvasKit = true;
        console.log('🔧 强制启用本地CanvasKit:', window._flutter.buildConfig.useLocalCanvasKit);
      }
    });
    
    // 拦截CanvasKit加载，强制使用本地路径
    const originalFetch = window.fetch;
    window.fetch = function(url, options) {
      if (typeof url === 'string' && url.includes('gstatic.com/flutter-canvaskit')) {
        // 重定向到本地CanvasKit
        const filename = url.split('/').pop();
        const localUrl = '/canvaskit/' + filename;
        console.log('🚫 拦截Google CDN请求:', url);
        console.log('✅ 重定向到本地:', localUrl);
        return originalFetch.call(this, localUrl, options);
      }
      return originalFetch.call(this, url, options);
    };
  </script>
</body>
</html>