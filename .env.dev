# ===========================================
# X0X ChatApp 开发环境配置
# ===========================================

# 应用基本信息
APP_NAME=X0X Chat App (Dev)
APP_VERSION=1.0.0-dev

# 服务器配置
NODE_ENV=development

# 端口配置
HTTP_PORT=9003
HTTPS_PORT=9443

# 用户配置
USER_ID=1000
GROUP_ID=1000

# 字体服务配置 (开发环境使用7000端口)
FONT_SERVICE_URL=http://127.0.0.1:7000

# 开发调试配置
DEBUG=true
LOG_LEVEL=debug

# ===========================================
# 开发说明
# ===========================================
# 1. 本地开发使用此配置文件
# 2. VS Code启动时会自动加载此配置
# 3. 字体服务需要先启动: cd ../fontss && npm run dev
# ===========================================