# Flutter Web Docker - Debug版本，包含详细日志和调试功能
FROM node:18-alpine AS runtime

# 安装基础工具和调试工具
RUN apk add --no-cache curl htop procps

WORKDIR /app

# 复制构建好的web文件
COPY build/web ./web/

# 复制Node.js服务器
COPY server.js ./

# 创建debug启动脚本
RUN printf '#!/bin/sh\n\
set -e\n\
\n\
echo "🚀 Flutter Web Docker 启动 - DEBUG模式"\n\
echo "📱 应用名称: ${APP_NAME}"\n\
echo "🏷️  版本: ${APP_VERSION}"\n\
echo "🌐 监听: ${HOST}:${PORT}"\n\
echo "🔧 环境: ${NODE_ENV}"\n\
echo "📊 日志级别: ${LOG_LEVEL}"\n\
echo "🐛 调试模式: 已启用"\n\
echo "🔧 WASM MIME支持: 已启用"\n\
echo "📦 字体: 完全本地化"\n\
echo "🔍 详细日志: 已启用"\n\
echo "⚡ 热重载: 支持"\n\
\n\
# 显示系统信息\n\
echo "💾 内存使用: $(free -h | grep Mem | awk '"'"'{print $3"/"$2}'"'"')"\n\
echo "💿 磁盘使用: $(df -h /app | tail -1 | awk '"'"'{print $3"/"$2" ("$5")"}'"'"')"\n\
echo "🕒 启动时间: $(date)"\n\
\n\
# 启动Node.js服务器（支持正确的MIME类型）\n\
cd /app\n\
echo "🔥 启动服务器..."\n\
exec node server.js\n' > start.sh

# 修改Node.js服务器配置为debug模式
RUN sed -i 's|build/web|web|g' server.js && \
    sed -i 's/const LOG_LEVEL = process.env.LOG_LEVEL || '"'"'info'"'"';/const LOG_LEVEL = process.env.LOG_LEVEL || '"'"'debug'"'"';/' server.js

# 添加debug日志到server.js
RUN sed -i '/console.log.*WASM:/a\\n    // Debug模式额外日志\n    if (LOG_LEVEL === "debug") {\n      console.log(`🔍 Debug: ${filePath} 请求时间: ${new Date().toISOString()}`);\n    }' server.js

RUN chmod +x start.sh

# Debug环境变量配置
ENV NODE_ENV=development
ENV PORT=80
ENV HOST=0.0.0.0
ENV APP_NAME="Flutter Web App (Debug)"
ENV APP_VERSION="1.0.0-debug"
ENV LOG_LEVEL=debug
ENV DEBUG=*

# 暴露HTTP和HTTPS端口
EXPOSE 80 443

# 健康检查（更频繁的检查，优先HTTPS）
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -k -f https://localhost:443/ || curl -f http://localhost:80/ || exit 1

# 检查并使用现有用户或创建新用户
RUN if getent passwd 1000 > /dev/null 2>&1; then \
        # 如果UID 1000已存在，使用该用户
        existing_user=$(getent passwd 1000 | cut -d: -f1) && \
        chown -R $existing_user:$(id -gn $existing_user) /app && \
        chmod -R 755 /app && \
        echo "Using existing user: $existing_user"; \
    else \
        # 如果UID 1000不存在，创建新用户
        adduser -D -u 1000 appuser && \
        chown -R appuser:appuser /app && \
        chmod -R 755 /app && \
        echo "Created new user: appuser"; \
    fi

# 切换到UID 1000用户（无论用户名是什么）
USER 1000

# Debug标签
LABEL version="debug" \
      description="Flutter Web Debug Container" \
      maintainer="Flutter Team"

# 启动命令
CMD ["./start.sh"]