{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter (Debug)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--debug"
            ]
        },
        {
            "name": "Flutter (Release)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--release"
            ]
        },
        {
            "name": "Flutter iOS Simulator",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "com.apple.CoreSimulator.SimRuntime.iOS-18-4"
        },
        {
            "name": "Flutter Web",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "chrome"
        },
        {
            "name": "Flutter Web (Edge)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "env": {
                "CHROME_EXECUTABLE": "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
            }
        },
        {
            "name": "Flutter Web Server (Debug)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "web-server",
            "args": [
                "--web-port=9003",
                "--web-hostname=localhost"
            ],
            "env": {
                "FONT_SERVER_URL": "http://localhost:7000"
            }
        },
        {
            "name": "Flutter Web Server (Font Dev)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "web-server",
            "args": [
                "--web-port=7002",
                "--web-hostname=localhost"
            ],
            "env": {
                "FONT_SERVER_URL": "http://localhost:3001"
            }
        }
    ]
}